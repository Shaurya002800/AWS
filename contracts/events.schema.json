{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewindguard.local/contracts/events.schema.json",
  "title": "RewindGuard event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "tenant_id", "subject_id", "subject_generation", "source_version", "authority_epoch_seen", "operation_type", "occurred_at", "trace_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_generation": {"type": "integer", "minimum": 1},
    "source_version": {"type": "integer", "minimum": 1},
    "authority_epoch_seen": {"type": "integer", "minimum": 0},
    "operation_type": {"type": "string", "enum": ["PROFILE_UPSERT", "DOCUMENT_UPSERT", "INDEX_UPSERT", "ERASURE_COMMITTED"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1}
  }
}
